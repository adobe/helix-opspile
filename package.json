    "@ai-ecoverse/wasm-bash": "5.3.0-23",
    "@ai-ecoverse/wasm-binutils": "2.47.0-8",
    "@ai-ecoverse/wasm-coreutils": "9.12.0-15",
    "@ai-ecoverse/wasm-curl": "8.22.0-10",
    "@ai-ecoverse/wasm-diffutils": "3.12.0-4",
    "@ai-ecoverse/wasm-findutils": "4.11.0-5",
    "@ai-ecoverse/wasm-gawk": "5.4.1-6",
    "@ai-ecoverse/wasm-grep": "3.12.0-8",
    "@ai-ecoverse/wasm-gzip": "1.15.0-6",
    "@ai-ecoverse/wasm-jq": "1.8.2-6",
    "@ai-ecoverse/wasm-sed": "4.10.0-6",
    "@ai-ecoverse/wasm-sqlite3": "3.54.1-1",
    "@ai-ecoverse/wasm-tar": "1.35.0-9",
    "@ai-ecoverse/wasm-tree": "2.3.2-7",
    "@ai-ecoverse/wasm-util-linux": "2.42.4-7",
    "@ai-ecoverse/wasm-which": "2.23.0-5",
    "@ai-ecoverse/wasm-zip": "3.0.0-11",
    "@modelcontextprotocol/server": "2.3.1",
    "@spectrum-css/tokens": "16.0.2",
    "cf": "1.0.0-beta.20",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "wrangler": "^4.151.3"
