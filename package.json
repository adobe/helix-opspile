{
  "name": "helix-opspile",
  "version": "0.1.0",
  "private": true,
  "description": "Unified ops inbox for Slack and Microsoft Teams, on Cloudflare",
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "deploy:prod": "cf deploy --mode prod",
    "deploy:stage": "cf deploy --mode stage",
    "lint": "eslint .",
    "test": "node --test",
    "ui:dev": "node --watch scripts/dev-ui.mjs",
    "ui:session": "node scripts/dev-ui-session.mjs"
  },
  "devDependencies": {
    "@adobe/eslint-config-helix": "^3.0.33",
    "cf": "1.0.0-beta.20",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "wrangler": "^4.151.3"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "agents": "0.30.0",
    "isomorphic-git": "1.44.3",
    "micromark": "4.0.3",
    "micromark-extension-gfm-autolink-literal": "2.1.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "micromark-extension-gfm-table": "2.1.2",
    "micromark-extension-gfm-task-list-item": "2.1.0",
    "typebox": "1.3.27"
