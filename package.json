{
  "name": "helix-opspile",
  "version": "0.1.0",
  "private": true,
  "description": "Unified ops inbox for Slack and Microsoft Teams, on Cloudflare",
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "deploy:prod": "cf deploy --mode prod",
    "deploy:stage": "cf deploy --mode stage",
    "lint": "eslint .",
    "test": "node --test",
    "ui:dev": "node --watch scripts/dev-ui.mjs",
    "ui:session": "node scripts/dev-ui-session.mjs",
    "computer:dev": "node scripts/dev-computer/dev.mjs",
    "computer:images": "node scripts/computer-images.mjs --upload",
    "rank": "node scripts/rank.mjs",
    "build": "node scripts/ui-markdown.mjs",
    "prelint": "npm run build --silent",
    "pretest": "npm run build --silent",
    "preui:dev": "npm run build --silent",
    "preui:session": "npm run build --silent",
    "precomputer:dev": "npm run build --silent"
  },
  "devDependencies": {
    "@adobe/eslint-config-helix": "^3.0.33",
    "@ai-ecoverse/wasi-quickjs": "0.18.0-1",
